# ===== Database =====
DATABASE_URL=postgresql://holdem:holdem_dev@localhost:5432/holdemnow?schema=public

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== JWT (인증) =====
# 본 운영 시 반드시 64자 이상 랜덤 문자열로 교체. 예: openssl rand -hex 64
JWT_SECRET=change-me-please-development-only
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===== 카카오 OAuth (플레이어 로그인) =====
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3001/api/auth/kakao/callback

# ===== FCM 푸시 (Firebase Cloud Messaging) =====
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# ===== AWS / 객체 저장소 (매장 사진) =====
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=holdemnow-photos-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===== 카카오맵 (서버에서 주소 → 좌표 변환) =====
KAKAO_MAP_REST_API_KEY=

# ===== 토스페이먼츠 (B2B 결제) =====
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=

# ===== 서버 =====
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:19000
