rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 헬퍼 =====
    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function hasRole(r) {
      return isSignedIn() && request.auth.token.role == r;
    }
    function isStoreMember(storeId) {
      return isSignedIn() && request.auth.token.storeId == storeId;
    }
    // v0.1 — Custom Claims 없이 ownerUid 직접 검증 (한 번의 get() read 발생)
    function isStoreOwner(storeId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/stores/$(storeId))
        && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid;
    }
    function isStoreOwnerOrMember(storeId) {
      return isStoreOwner(storeId) || isStoreMember(storeId);
    }
    function isOrganizerMember(orgId) {
      return isSignedIn() && request.auth.token.organizerId == orgId;
    }
    // v0.1: Custom Claims 미적용 — Firestore users/{uid} 문서의 role/roles 필드로 검증.
    // Firestore rules는 list membership을 'x' in [...] 가 아닌 .hasAny([...])로 검사해야 함.
    function isPlatformAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'platform_admin'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []).hasAny(['platform_admin'])
        );
    }

    // ===== 매장 =====
    match /stores/{storeId} {
      // 본사 미승인 매장은 일반 사용자에게 노출 차단.
      // status 필드가 없는 기존 doc(데모 시드 등)은 'active'로 간주 — 하위호환.
      // owner 본인 + platform_admin + 데모 매장은 read 가능.
      allow read: if resource.data.get('status', 'active') == 'active'
        || resource.data.get('isDemo', false) == true
        || isPlatformAdmin()
        || (isSignedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
      // 인증된 사용자가 본인을 owner로 매장 생성 + status=pending 강제
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending';
      // 일반 owner는 status 변경 불가. platform_admin만 status 변경 가능.
      allow update: if isSignedIn()
        && (
          // 매장 owner: status 필드를 변경하지 않는 경우만
          (resource.data.ownerUid == request.auth.uid
            && !('status' in request.resource.data.diff(resource.data)))
          // 본사 관리자: 모든 필드 변경 가능 (승인/반려/정지)
          || isPlatformAdmin()
          // 스태프: status 외 업무 데이터
          || isStoreMember(storeId)
          // 데모 매장: 누구나 업데이트 가능
          || resource.data.isDemo == true
        );
      allow delete: if isSignedIn()
        && (resource.data.ownerUid == request.auth.uid
            || isPlatformAdmin()
            || resource.data.isDemo == true);

      match /staff/{staffId} {
        allow read: if isStoreMember(storeId);
        allow write: if isStoreMember(storeId) && request.auth.token.storeRole == 'master';
      }

      match /tournamentTemplates/{templateId} {
        // platform_admin은 본사 모니터링 페이지에서 임의 매장의 템플릿 조회·LIVE 생성 가능.
        allow read: if isStoreOwnerOrMember(storeId) || isPlatformAdmin();
        allow write: if isStoreOwnerOrMember(storeId) || isPlatformAdmin();
      }

      match /tournaments/{tournamentId} {
        allow read: if true;                             // 플레이어도 캘린더에서 조회
        allow write: if isStoreOwnerOrMember(storeId) || isPlatformAdmin();
      }

      match /displaySlots/{slotNum} {
        allow read: if true;                             // TV 디스플레이는 URL만으로 접근 가능
        allow write: if isStoreOwnerOrMember(storeId) || isPlatformAdmin();
      }

      // 매장별 토너 타이머 디스플레이 prefs (배경/색/공지/스폰서) —
      // TV 풀스크린이 URL만으로 접근 가능해야 하므로 read=public.
      // write는 매장 owner/member 또는 platform_admin만.
      match /timerDisplay/{docId} {
        allow read: if true;
        allow write: if isStoreOwnerOrMember(storeId) || isPlatformAdmin();
      }

      // 매장별 타이머 디스플레이 다중 프리셋 (Phase 2, 2026-05-21) —
      // 사장이 여러 배경/색 조합을 저장해두고 빠르게 전환.
      // read=public(프리셋 미리보기 미리보기 패널에서도 활용), write=owner/member/platform_admin.
      match /timerDisplayPresets/{presetId} {
        allow read: if true;
        allow write: if isStoreOwnerOrMember(storeId) || isPlatformAdmin();
      }

      // 노출·클릭 카운터 (sharded-free, v0.1 demo)
      // v0.1: 누구나 increment 가능 — 베타에서 abuse 감지 시 Cloud Function 인덱싱으로 이관
      match /metrics/{metricId} {
        allow read: if true;
        allow write: if true;
      }

      // 매장 데일리 홍보 "오늘의 소식" — 매장 owner/member/platform_admin만 write, 누구나 read.
      // pending 매장이어도 owner는 미리 글 작성 가능 — 매장이 사용자에게 노출 안 되는 동안
      // 글도 마찬가지로 노출되지 않으며, status=active로 전환되는 순간 함께 노출됨.
      // 이는 사장 입장에서 가입 직후부터 운영 데이터를 입력해두는 데 필수.
      // collectionGroup('posts') 쿼리는 아래 별도 와일드카드 규칙으로 허용.
      match /posts/{postId} {
        allow read: if true;
        allow create: if isSignedIn()
          && (isStoreOwner(storeId) || isStoreMember(storeId) || isPlatformAdmin())
          && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isSignedIn()
          && (isStoreOwner(storeId) || isStoreMember(storeId) || isPlatformAdmin());
      }

      // 매장 예약 (reservations) — 본인 또는 매장 owner/member만 read.
      // - create: 본인 uid + storeId 일치, status='pending' 강제, partySize 1~20 검증.
      // - update: 본인은 status='cancelled'로만 (취소), 매장 owner/member는 운영 상태 갱신.
      // - delete: platform_admin만 — 매장이 함부로 못 지우게 이력 보존.
      // collectionGroup('reservations') 쿼리는 별도 와일드카드 규칙에서 본인 read 허용.
      match /reservations/{reservationId} {
        allow read: if isSignedIn() && (
          resource.data.authorUid == request.auth.uid
          || isStoreOwner(storeId)
          || isStoreMember(storeId)
          || isPlatformAdmin()
        );
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.storeId == storeId
          && request.resource.data.partySize is int
          && request.resource.data.partySize >= 1
          && request.resource.data.partySize <= 20
          && request.resource.data.status == 'pending';
        allow update: if isSignedIn() && (
          // 예약자 본인: status='cancelled' 로만 취소 가능.
          // pending(매장 확인 전)은 즉시 취소 OK.
          // confirmed/그 외 상태에서는 reservedFor 1시간 전까지만 취소 가능.
          (resource.data.authorUid == request.auth.uid
            && request.resource.data.status == 'cancelled'
            && (
              resource.data.status == 'pending'
              || resource.data.reservedFor.toMillis() - request.time.toMillis() >= 60 * 60 * 1000
            ))
          // 매장 owner/member: 운영 상태·readByStore·confirmedAt 갱신 가능 (시간 제약 없음)
          || isStoreOwner(storeId)
          || isStoreMember(storeId)
          || isPlatformAdmin()
        );
        allow delete: if isPlatformAdmin();
      }

      // 방문 리뷰 — 누구나 read, 인증 사용자가 본인 명의로만 write.
      // 집계 필드(reviewCount/averageRating/ratingDistribution)는 Cloud Function이 자동 갱신.
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.storeId == storeId
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        // 본인은 본인 리뷰 update (rating·body·photoUrls 등), 또는 platform_admin이
        // hidden 토글 등 운영 목적으로 update 가능.
        // 매장 owner/member는 storeReply 필드(답글)만 변경 가능 — 다른 본문 변경 차단.
        allow update: if isSignedIn() && (
          (
            resource.data.authorUid == request.auth.uid
            && request.resource.data.authorUid == request.auth.uid  // uid 변경 차단
            && request.resource.data.rating is int
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5
          )
          || isPlatformAdmin()
          // 매장 owner/member 답글 — storeReply 외 다른 본문(rating·body·authorUid·photoUrls)은
          // 변경 불가. resource.data.rating/body/authorUid가 그대로 유지될 때만 통과.
          || (
            (isStoreOwner(storeId) || isStoreMember(storeId))
            && resource.data.authorUid == request.resource.data.authorUid
            && resource.data.rating == request.resource.data.rating
            && resource.data.body == request.resource.data.body
          )
        );
        allow delete: if isSignedIn()
          && (resource.data.authorUid == request.auth.uid || isPlatformAdmin());
      }
    }

    // ===== LIVE 세션 (실시간 송출의 심장) =====
    match /liveSessions/{sessionId} {
      allow read: if true;                               // 누구나 LIVE 피드 구독
      // platform_admin은 임의 매장에 LIVE 시작 가능 (본사 모니터링 페이지에서 매장 사장 부재 시 대신 실행).
      // pending 매장은 LIVE 시작 차단 — 본사 승인 후에만 가능.
      // status 필드 없는 기존 매장은 'active'로 간주 (하위호환).
      allow create: if isSignedIn()
        && (isStoreOwner(request.resource.data.storeId)
            || isStoreMember(request.resource.data.storeId)
            || isPlatformAdmin())
        && (
          isPlatformAdmin()
          || get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.get('status', 'active') == 'active'
          || get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.get('isDemo', false) == true
        );
      // platform_admin은 본사 모니터링 페이지에서 전국 LIVE를 직접 제어 가능 (긴급 정지·종료·시간 조정).
      allow update: if isSignedIn()
        && (isStoreOwner(resource.data.storeId)
            || isStoreMember(resource.data.storeId)
            || isPlatformAdmin());
      allow delete: if isSignedIn()
        && (isStoreOwner(resource.data.storeId)
            || isStoreMember(resource.data.storeId)
            || isPlatformAdmin());

      match /events/{eventId} {
        // 이벤트 로그는 매장 스태프만 read, write는 Functions에서만
        allow read: if isStoreMember(
          get(/databases/$(database)/documents/liveSessions/$(sessionId)).data.storeId
        );
        allow write: if false;
      }
    }

    // ===== LIVE 세션 종료 audit (2026-05-21 3차 핫픽스) =====
    // 모든 stopLiveSession 호출 / 자가 치유 시도가 여기 기록됨. 결정적 진단용.
    // 누구나 작성 (사장·본사·자동 cron) — 진단 데이터이므로 손실 방지가 우선.
    // 읽기는 platform_admin만 (사용자 식별 정보 포함 가능).
    match /liveSessionsAudit/{auditId} {
      allow read: if isPlatformAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ===== 사용자 =====
    match /users/{userId} {
      // 본인 또는 platform_admin 읽기 가능 (회원 관리 페이지)
      allow read: if isSignedIn() && (uid() == userId || isPlatformAdmin());
      allow create: if isSignedIn() && uid() == userId;
      // 일반 사용자는 본인만 update, platform_admin은 status 변경 가능
      allow update: if isSignedIn() && (uid() == userId || isPlatformAdmin());
      allow delete: if false;                            // 소프트 삭제만

      match /favorites/{storeId} {
        allow read, write: if uid() == userId;
      }
      match /interests/{tournamentId} {
        allow read, write: if uid() == userId;
      }
      match /seriesSubscriptions/{seriesId} {
        allow read, write: if uid() == userId;
      }
      // FCM 디바이스 토큰 (멀티 디바이스 지원) — 본인만
      match /fcmTokens/{tokenId} {
        allow read, write: if uid() == userId;
      }
    }

    // ===== 전화번호 중복 방지 인덱스 (phoneIndex) =====
    // doc id = 정규화된 한국 핸드폰 번호 (예: "01012345678").
    // 1인 1계정 정책: 어떤 가입 방식이든 사용자가 직접 입력한 전화번호로 unique 보장.
    // - read: 누구나(인증) — 중복 검사 / 본인 번호 확인용. 번호를 알아야 hit 하므로 임의 추측 어려움.
    // - create/update: 본인 uid를 doc.uid 필드로 기록한 경우만, 또는 platform_admin.
    // - delete: 본인 또는 platform_admin (번호 변경 시 이전 번호 정리).
    match /phoneIndex/{phoneNumber} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.uid == request.auth.uid
        || isPlatformAdmin()
      );
      allow update: if isSignedIn() && (
        (resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid)
        || isPlatformAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || isPlatformAdmin()
      );
    }

    // ===== 비밀번호 복구 정보 (Email/Password 가입자 전용) =====
    // doc id = 소문자 이메일. 조회 키가 이메일이므로 임의 추측 어려움 (v0.1 보안 수준).
    // 가입 시 본인 uid로 생성, 분실 복구 시 read (이메일 알아야 조회 가능).
    // platform_admin도 read 허용 (고객 지원용).
    match /passwordRecovery/{emailKey} {
      // anonymous(비번 분실 사용자)도 read 필수 — 이메일 키 알아야 조회 가능.
      // 노출 정보: passwordHint + recoveryLast4(4자리). 비번 자체는 Firebase Auth hash로 별도 보호.
      allow read: if true;
      allow create: if isSignedIn();   // 가입 시 자신의 정보 생성
      allow update: if isSignedIn();   // 비밀번호 변경 시 본인이 갱신
      allow delete: if false;
    }

    // ===== 시리즈 (대회사) — v0.1: 인증된 사용자 = ownerUid로 직접 검증 =====
    match /series/{seriesId} {
      allow read: if true;                               // 모바일 시리즈 페이지 누구나
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && (resource.data.ownerUid == request.auth.uid
            || isOrganizerMember(resource.data.organizerId)
            || isPlatformAdmin());

      match /finalists/{finalistId} {
        allow read: if true;
        allow write: if isSignedIn() && (
          get(/databases/$(database)/documents/series/$(seriesId)).data.ownerUid == request.auth.uid
          || isOrganizerMember(get(/databases/$(database)/documents/series/$(seriesId)).data.organizerId)
          || isPlatformAdmin()
        );
      }
    }

    // ===== 대회사 — ownerUid 직접 검증 =====
    match /organizers/{organizerId} {
      allow read: if true;
      // 가입 신청: status=pending 강제
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn()
        && (
          // owner: status 변경 불가
          (resource.data.ownerUid == request.auth.uid
            && !('status' in request.resource.data.diff(resource.data)))
          // 본사 관리자: 모든 필드 변경 (승인/반려/정지)
          || isPlatformAdmin()
          || isOrganizerMember(organizerId)
        );
      allow delete: if isSignedIn()
        && (resource.data.ownerUid == request.auth.uid || isPlatformAdmin());

      match /staff/{staffId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    // ===== 지역 lookup =====
    match /regions/{regionCode} {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    // ===== 본사 팝업 공지 =====
    // 모바일/어드민 진입 시 표시되는 본사 공지. 본사 관리자만 등록 의도지만 v0.1은
    // platform_admin token claim이 없으므로 인증 사용자 누구나 write 허용(데모 패턴).
    match /notices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // ===== 본사 pinned 글 (홈 인라인 고정 공지) =====
    // 팝업 notices와 별개로, 모바일 홈 "오늘의 매장 소식" 섹션 최상단에 고정 노출.
    // v0.1: 인증 사용자 누구나 write 허용(데모 패턴). 페이지는 platform_admin gating.
    match /pinnedPosts/{postId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // ===== 커뮤니티 (구인/구직/중고거래) =====
    // 통합 community 컬렉션 — type 분기. v0.1은 jobOffer만 활성.
    // - read: 누구나 (status='hidden'은 클라이언트 필터)
    // - jobOffer create: 매장 owner만(authorUid=본인 + storeId 매장 owner 검증)
    // - dealerProfile (v0.2): 본인 uid 프로필만
    // - usedListing (v0.2): 매장 owner만
    // - update/delete: 작성자 본인 또는 platform_admin (모더레이션)
    match /community/{itemId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && (
          (request.resource.data.type == 'jobOffer'
            && isStoreOwner(request.resource.data.storeId))
          || (request.resource.data.type == 'dealerProfile')
          || (request.resource.data.type == 'usedListing'
            && isStoreOwner(request.resource.data.storeId))
        );
      // update — 작성자 본인만 본문 변경 가능. authorUid·type 변경 차단으로
      // 권한 escalation 방어(다른 사람 uid로 바꿔치기 금지). platform_admin은
      // 모더레이션(hidden 토글 등) 목적으로 자유 update 허용.
      allow update: if isSignedIn() && (
        (resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.type == resource.data.type)
        || isPlatformAdmin()
      );
      allow delete: if isSignedIn()
        && (resource.data.authorUid == request.auth.uid || isPlatformAdmin());
    }

    // ===== 대회 (events) — 국내외 메이저 토너먼트 이벤트 =====
    // 대회사 또는 platform_admin이 등록. 모바일 사용자는 누구나 조회.
    match /events/{eventId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        isPlatformAdmin()
        || request.resource.data.ownerUid == request.auth.uid
      );
      allow update: if isSignedIn() && (
        isPlatformAdmin()
        || resource.data.ownerUid == request.auth.uid
        || (resource.data.organizerId != null && isOrganizerMember(resource.data.organizerId))
      );
      allow delete: if isSignedIn() && (
        isPlatformAdmin()
        || resource.data.ownerUid == request.auth.uid
      );
    }

    // ===== Collection Group 쿼리용 recursive 와일드카드 규칙 =====
    // stores/{storeId}/tournaments/{tournamentId} 같이 중첩된 path에 대해
    // collectionGroup('tournaments') 쿼리도 허용.
    // 기존 nested path 규칙(stores/{storeId}/tournaments)도 유효하며 둘 다 매칭됨.
    match /{path=**}/tournaments/{tournamentId} {
      allow read: if true;  // 모바일 캘린더는 전체 토너 조회 (collectionGroup)
    }
    // 모바일 홈 "오늘의 매장 소식"이 collectionGroup('posts')로 전체 매장 글을 한 번에 읽음.
    match /{path=**}/posts/{postId} {
      allow read: if true;
    }
    // 내 리뷰 전체 보기(collectionGroup('reviews')) — 모든 매장 리뷰 누구나 read.
    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
    }
    // 내 예약 전체 보기(collectionGroup('reservations')) — 본인 또는 platform_admin만 read.
    // 매장 owner/member용 매장별 조회는 nested rule이 처리하며, 이 와일드카드는
    // 사용자 본인 마이페이지(전 매장 자기 예약)와 본사 모니터링에 한정.
    match /{path=**}/reservations/{reservationId} {
      allow read: if isSignedIn()
        && (resource.data.authorUid == request.auth.uid || isPlatformAdmin());
    }

    // ===== 본사 마케팅 캠페인 (platformCampaigns) =====
    // 마케팅 푸시 캠페인 — title/body/imageUrl/linkUrl/isAdvertisement + 즉시·예약 발송 + 통계.
    // 발송 로직은 Cloud Function(marketingBroadcast / processScheduledCampaigns)이 status·통계 필드를 갱신.
    // - read: sent/sending 상태는 누구나 (인앱 /m/campaigns/[id] 진입용 — 푸시 클릭한 비로그인도 OK).
    //         draft/scheduled/failed/cancelled는 platform_admin만 (관리 영역).
    // - create: platform_admin, sentBy=본인 uid 강제.
    // - update: platform_admin && status ∈ {draft, scheduled} — 발송 중/완료/취소/실패 건은 잠금.
    // - delete: platform_admin && status ∈ {draft, cancelled, failed} — 발송 완료/sending은 이력 보관.
    match /platformCampaigns/{campaignId} {
      allow read: if isPlatformAdmin()
        || (resource != null && resource.data.status in ['sent', 'sending']);
      allow create: if isPlatformAdmin()
        && request.resource.data.sentBy == request.auth.uid;
      allow update: if isPlatformAdmin()
        && resource.data.status in ['draft', 'scheduled'];
      allow delete: if isPlatformAdmin()
        && resource.data.status in ['draft', 'cancelled', 'failed'];
    }

    // ===== 감사 로그 (auditLogs) =====
    // platform_admin만 read/create. 생성 시 actor == 본인 uid 강제.
    // update/delete 불가 — 감사 로그는 불변.
    match /auditLogs/{logId} {
      allow read: if isPlatformAdmin();
      allow create: if isPlatformAdmin()
        && request.resource.data.actor == request.auth.uid;
      allow update, delete: if false;
    }

    // ===== 플랫폼 메타 문서 (homeContentCounts 등) =====
    // read: 누구나 (사이드바 배지·모바일 홈 빈 상태 판정).
    // write: platform_admin만 (home-content 페이지 CRUD 직후 클라이언트 write).
    match /meta/{docId} {
      allow read: if true;
      allow create, update, delete: if isPlatformAdmin();
    }

    // ===== 플랫폼 설정 (platformConfig/youtubeCuration 등) =====
    // 자동 큐레이션 키워드·갯수·실행 시각 설정. Cloud Function curateHotVideos가
    // 매시 정각 이 doc을 읽고 적용. 본사 어드민이 home-content 페이지에서 수정.
    // - read: 누구나 (모바일 홈에서 마지막 큐레이션 결과 노출 가능성)
    // - write: platform_admin만
    match /platformConfig/{docId} {
      allow read: if true;
      allow create, update, delete: if isPlatformAdmin();
    }

    // ===== 홈 콘텐츠 — 광고/유튜브영상/유튜버 (모바일 홈 노출) =====
    // read: 누구나 (모바일 홈 공개 노출).
    // write: platform_admin만 (본사 콘텐츠 관리 페이지).
    match /homeAds/{adId} {
      allow read: if true;
      allow create, update, delete: if isPlatformAdmin();
    }
    match /hotYoutubeVideos/{vid} {
      allow read: if true;
      allow create, update, delete: if isPlatformAdmin();
    }
    match /hotYoutubers/{cid} {
      allow read: if true;
      allow create, update, delete: if isPlatformAdmin();
    }

    // ===== 광고 슬롯 (adSlots) — Sprint 3 Phase C =====
    // 매장 광고 노출권. v0.1은 본사 수동 부여만(클라 결제 없음).
    // - read: 누구나 (모바일 홈/매장찾기 슬롯 분배에 사용).
    // - write: platform_admin만 (v0.1). v0.2에 매장 owner self-purchase 권한 확장 예정.
    // - 클라이언트가 impressions/clicks 카운트를 직접 increment하는 것을 허용 (writeRateLimits 패턴 동일).
    match /adSlots/{adId} {
      allow read: if true;
      allow create, delete: if isPlatformAdmin();
      // platform_admin은 모든 필드 변경 가능. 일반 사용자는 impressions/clicks 카운트만 increment 허용.
      allow update: if isPlatformAdmin()
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['impressions', 'clicks', 'updatedAt'])
        );
    }

    // ===== 신고 (reports) — Phase B 모더레이션 =====
    // reportId = `${reviewId}_${reporterUid}` 형식 → 같은 사용자 중복 신고 차단.
    // - read: 본인 신고는 본인 read, platform_admin은 전체 read.
    // - create: 인증 사용자, reporterUid == 본인 uid 강제.
    // - update/delete: platform_admin만 (resolved 등 처리).
    match /reports/{reportId} {
      allow read: if isSignedIn()
        && (resource.data.reporterUid == request.auth.uid || isPlatformAdmin());
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid;
      allow update: if isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    // ===== 작성 빈도 제한 (writeRateLimits) =====
    // docId = `${uid}_${namespace}` 형태. doc 안 uid 필드로 본인 검증.
    // 본인 doc만 read·write — 다른 사람 빈도 카운터 조작 차단.
    match /writeRateLimits/{docId} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // ===== 피드 설정 변경 이력 (feedConfigHistory) =====
    // /platform/feed-config 페이지가 meta/feedConfig 저장 시 함께 기록.
    // - read: platform_admin만 (운영 이력).
    // - create: platform_admin만 (저장 시점에 actorUid==본인 강제).
    // - update/delete: 불변.
    match /feedConfigHistory/{logId} {
      allow read: if isPlatformAdmin();
      allow create: if isPlatformAdmin()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ===== 금지어 사전 (moderationKeywords) — 2026-05-22 =====
    // 본사 어드민 /platform/moderation-keywords에서 단어 관리.
    // 매장 글·리뷰·커뮤니티 작성 시 클라이언트에서 직접 fetch + 1분 캐시 + onSnapshot 실시간 반영.
    // - read: 누구나 (사용자 글 작성 검증용. 단어 자체가 유출되어도 보안 영향 없음).
    // - write: platform_admin만 (단어 추가/삭제/토글).
    match /moderationKeywords/{keywordId} {
      allow read: if true;
      allow create, update, delete: if isPlatformAdmin();
    }

    // ===== 본사 감사 로그 (adminAuditLog) =====
    // 본사 관리자 행위(비밀번호 재설정 메일 발송 등) 기록.
    // - read: platform_admin만.
    // - create: Cloud Functions(Admin SDK)에서만 기록 — 클라는 절대 직접 못 씀.
    // - update/delete: 불가 — 감사 로그 불변.
    match /adminAuditLog/{logId} {
      allow read: if isPlatformAdmin();
      allow create: if false;  // Functions에서만 (admin SDK는 rules 우회)
      allow update, delete: if false;
    }

    // ===== 그 외 모두 차단 (default deny) =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
