rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 헬퍼 =====
    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function hasRole(r) {
      return isSignedIn() && request.auth.token.role == r;
    }
    function isStoreMember(storeId) {
      return isSignedIn() && request.auth.token.storeId == storeId;
    }
    // v0.1 — Custom Claims 없이 ownerUid 직접 검증 (한 번의 get() read 발생)
    function isStoreOwner(storeId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/stores/$(storeId))
        && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid;
    }
    function isStoreOwnerOrMember(storeId) {
      return isStoreOwner(storeId) || isStoreMember(storeId);
    }
    function isOrganizerMember(orgId) {
      return isSignedIn() && request.auth.token.organizerId == orgId;
    }
    // v0.1: Custom Claims 미적용 — Firestore users/{uid} 문서의 role/roles 필드로 검증.
    // Firestore rules는 list membership을 'x' in [...] 가 아닌 .hasAny([...])로 검사해야 함.
    function isPlatformAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'platform_admin'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []).hasAny(['platform_admin'])
        );
    }

    // ===== 매장 =====
    match /stores/{storeId} {
      allow read: if true;                               // 누구나 매장 조회
      // v0.1: 인증된 사용자가 본인을 owner로 매장 생성 가능 (심사 흐름은 v0.2)
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.ownerUid == request.auth.uid
            || isStoreMember(storeId)
            || isPlatformAdmin()
            || resource.data.isDemo == true);
      // v0.1: ownerUid 본인이면 삭제 가능 + 데모 매장(isDemo=true)은 인증 사용자 누구나 삭제.
      // 본사 관리자 token claim이 아직 없을 때도(셀프 부여한 role은 Firestore 문서뿐) 데모 정리가 가능하도록.
      // 운영 단계에서는 매장 폐업 신청 → 본사 승인 플로우로 교체.
      allow delete: if isSignedIn()
        && (resource.data.ownerUid == request.auth.uid
            || isPlatformAdmin()
            || resource.data.isDemo == true);

      match /staff/{staffId} {
        allow read: if isStoreMember(storeId);
        allow write: if isStoreMember(storeId) && request.auth.token.storeRole == 'master';
      }

      match /tournamentTemplates/{templateId} {
        // platform_admin은 본사 모니터링 페이지에서 임의 매장의 템플릿 조회·LIVE 생성 가능.
        allow read: if isStoreOwnerOrMember(storeId) || isPlatformAdmin();
        allow write: if isStoreOwnerOrMember(storeId) || isPlatformAdmin();
      }

      match /tournaments/{tournamentId} {
        allow read: if true;                             // 플레이어도 캘린더에서 조회
        allow write: if isStoreOwnerOrMember(storeId);
      }

      match /displaySlots/{slotNum} {
        allow read: if true;                             // TV 디스플레이는 URL만으로 접근 가능
        allow write: if isStoreOwnerOrMember(storeId);
      }

      // 노출·클릭 카운터 (sharded-free, v0.1 demo)
      // v0.1: 누구나 increment 가능 — 베타에서 abuse 감지 시 Cloud Function 인덱싱으로 이관
      match /metrics/{metricId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // ===== LIVE 세션 (실시간 송출의 심장) =====
    match /liveSessions/{sessionId} {
      allow read: if true;                               // 누구나 LIVE 피드 구독
      // platform_admin은 임의 매장에 LIVE 시작 가능 (본사 모니터링 페이지에서 매장 사장 부재 시 대신 실행).
      allow create: if isSignedIn()
        && (isStoreOwner(request.resource.data.storeId)
            || isStoreMember(request.resource.data.storeId)
            || isPlatformAdmin());
      // platform_admin은 본사 모니터링 페이지에서 전국 LIVE를 직접 제어 가능 (긴급 정지·종료·시간 조정).
      allow update: if isSignedIn()
        && (isStoreOwner(resource.data.storeId)
            || isStoreMember(resource.data.storeId)
            || isPlatformAdmin());
      allow delete: if isSignedIn()
        && (isStoreOwner(resource.data.storeId)
            || isStoreMember(resource.data.storeId)
            || isPlatformAdmin());

      match /events/{eventId} {
        // 이벤트 로그는 매장 스태프만 read, write는 Functions에서만
        allow read: if isStoreMember(
          get(/databases/$(database)/documents/liveSessions/$(sessionId)).data.storeId
        );
        allow write: if false;
      }
    }

    // ===== 사용자 =====
    match /users/{userId} {
      allow read: if isSignedIn() && uid() == userId;
      allow create: if isSignedIn() && uid() == userId;
      allow update: if isSignedIn() && uid() == userId;
      allow delete: if false;                            // 소프트 삭제만

      match /favorites/{storeId} {
        allow read, write: if uid() == userId;
      }
      match /interests/{tournamentId} {
        allow read, write: if uid() == userId;
      }
      match /seriesSubscriptions/{seriesId} {
        allow read, write: if uid() == userId;
      }
      // FCM 디바이스 토큰 (멀티 디바이스 지원) — 본인만
      match /fcmTokens/{tokenId} {
        allow read, write: if uid() == userId;
      }
    }

    // ===== 시리즈 (대회사) — v0.1: 인증된 사용자 = ownerUid로 직접 검증 =====
    match /series/{seriesId} {
      allow read: if true;                               // 모바일 시리즈 페이지 누구나
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && (resource.data.ownerUid == request.auth.uid || isOrganizerMember(resource.data.organizerId));

      match /finalists/{finalistId} {
        allow read: if true;
        allow write: if isSignedIn() && (
          get(/databases/$(database)/documents/series/$(seriesId)).data.ownerUid == request.auth.uid
          || isOrganizerMember(get(/databases/$(database)/documents/series/$(seriesId)).data.organizerId)
        );
      }
    }

    // ===== 대회사 — v0.1: ownerUid 직접 검증 =====
    match /organizers/{organizerId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.ownerUid == request.auth.uid || isOrganizerMember(organizerId));
      allow delete: if isSignedIn()
        && (resource.data.ownerUid == request.auth.uid || isPlatformAdmin());

      match /staff/{staffId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    // ===== 지역 lookup =====
    match /regions/{regionCode} {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    // ===== 본사 팝업 공지 =====
    // 모바일/어드민 진입 시 표시되는 본사 공지. 본사 관리자만 등록 의도지만 v0.1은
    // platform_admin token claim이 없으므로 인증 사용자 누구나 write 허용(데모 패턴).
    match /notices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // ===== 대회 (events) — 국내외 메이저 토너먼트 이벤트 =====
    // 대회사 또는 platform_admin이 등록. 모바일 사용자는 누구나 조회.
    match /events/{eventId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        isPlatformAdmin()
        || request.resource.data.ownerUid == request.auth.uid
      );
      allow update: if isSignedIn() && (
        isPlatformAdmin()
        || resource.data.ownerUid == request.auth.uid
        || (resource.data.organizerId != null && isOrganizerMember(resource.data.organizerId))
      );
      allow delete: if isSignedIn() && (
        isPlatformAdmin()
        || resource.data.ownerUid == request.auth.uid
      );
    }

    // ===== Collection Group 쿼리용 recursive 와일드카드 규칙 =====
    // stores/{storeId}/tournaments/{tournamentId} 같이 중첩된 path에 대해
    // collectionGroup('tournaments') 쿼리도 허용.
    // 기존 nested path 규칙(stores/{storeId}/tournaments)도 유효하며 둘 다 매칭됨.
    match /{path=**}/tournaments/{tournamentId} {
      allow read: if true;  // 모바일 캘린더는 전체 토너 조회 (collectionGroup)
    }

    // ===== 그 외 모두 차단 (default deny) =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
