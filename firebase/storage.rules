rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }
    function isImage() { return request.resource.contentType.matches('image/.*'); }
    function maxSize(mb) { return request.resource.size < mb * 1024 * 1024; }

    // 매장 사진 (v0.1 — 인증된 사용자만, storeId 권한은 클라이언트에서 검증)
    // TODO v0.2: Custom Claims로 storeId 권한 정밀화
    match /stores/{storeId}/photos/{photoId} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && maxSize(5);
    }

    match /series/{seriesId}/{file=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && maxSize(5);
    }

    // 대회(events) 포스터 — 인증된 사용자만 업로드, 정밀 권한은 Firestore rules에서.
    match /events/{eventId}/{file=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && maxSize(5);
    }

    // 대회사(organizers) 로고
    match /organizers/{organizerId}/{file=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && maxSize(3);
    }

    match /users/{userId}/avatar/{file} {
      allow read: if true;
      allow write: if request.auth.uid == userId && isImage() && maxSize(2);
    }

    // 본사 공지 첨부 이미지 — 인증 사용자만 업로드 (페이지 자체가 platform_admin gating)
    match /notices/{noticeId}/{file=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && maxSize(5);
    }

    // 매장 데일리 홍보 글 이미지 + 본사 pinned 글 이미지 (_pinned 하위 폴더)
    // posts/{storeId}/{postId}/{filename} — 인증 사용자만 업로드(매장 권한은 Firestore rules에서 검증)
    // posts/_pinned/{postId}/{filename} — 본사 pinned 글
    match /posts/{folder}/{file=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && maxSize(5);
    }

    // 커뮤니티 (구인/구직/중고) 이미지 — 인증 사용자만 업로드, 권한은 Firestore rules에서.
    match /community/{itemIdOrTemp}/{file=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && maxSize(5);
    }

    // 방문 리뷰 사진 — 인증 사용자만 업로드 (Firestore rules에서 본인 doc만 write 가능).
    // 경로: reviews/{reviewIdOrTemp}/{filename}. 최대 5MB.
    match /reviews/{reviewIdOrTemp}/{file=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && maxSize(5);
    }

    // 홈 광고 이미지 (16:9 커버, 최대 5MB)
    match /homeAds/{adId}/{file=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && maxSize(5);
    }

    // 인기 유튜버 아바타 (최대 2MB)
    match /hotYoutubers/{cid}/{file=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && maxSize(2);
    }

    // 본사 마케팅 캠페인 알림 이미지 — 푸시 알림 이미지로 사용되므로 누구나 read.
    // 페이지 자체가 platform_admin gating이며 Firestore rules가 캠페인 doc 권한을 제어.
    // v0.1: 인증 사용자면 write 허용. v0.2에서 platform_admin custom claim 강화.
    match /campaigns/{campaignId}/{file=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && maxSize(5);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
